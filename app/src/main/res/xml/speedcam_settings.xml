<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/speedcam_settings_title">

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/speedcam_enabled_key"
        android:summary="@string/speedcam_enabled_summary"
        android:title="@string/speedcam_enabled_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="@string/speedcam_distance_default_value"
        android:dependency="@string/speedcam_enabled_key"
        android:entries="@array/speedcam_distance_description"
        android:entryValues="@array/speedcam_distance_values"
        android:key="@string/speedcam_distance_key"
        android:title="@string/speedcam_distance_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <Preference
        android:key="@string/speedcam_battery_key"
        android:summary="@string/speedcam_battery_summary"
        android:title="@string/speedcam_battery_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/speedcam_test_key"
        android:summary="@string/speedcam_test_summary"
        android:title="@string/speedcam_test_title"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
